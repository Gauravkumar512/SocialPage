PORT=5000

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/socialpage

# Long random string used to sign access tokens (short-lived)
JWT_SECRET=replace-with-a-long-random-secret

# Long random string used to sign refresh tokens (long-lived, must differ from JWT_SECRET)
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173

# Cloudinary (create a free account at cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
